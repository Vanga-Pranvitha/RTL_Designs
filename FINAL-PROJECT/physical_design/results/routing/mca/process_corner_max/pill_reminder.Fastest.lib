library (pill_reminder) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00150,  0.00450,  0.01348,  0.04042,  0.12121,  0.36347");
  }
  type ("interval_sel") {
    base_type : array;
    data_type : bit;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0;
  }

  cell ("pill_reminder") {
    interface_timing : true;
    pin("ack_btn") {
      direction : input;
      capacitance : 0.0029;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.01609");
	}
	fall_constraint(scalar) {
          values("-0.01572");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.00406");
	}
	fall_constraint(scalar) {
          values("0.04622");
	}
      }
    }
    pin("buzzer") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.14839,2.15227,2.16198,2.18742,2.26103,2.48196,3.14248");
	}
	rise_transition(template_1) {
          values("0.01233,0.01614,0.02751,0.06308,0.17346,0.50488,1.49834");
	}
	cell_fall(template_1) {
          values("2.08216,2.08580,2.09435,2.11401,2.16496,2.31428,2.76371");
	}
	fall_transition(template_1) {
          values("0.01139,0.01410,0.02138,0.04197,0.10589,0.30356,0.90509");
	}
      }
    }
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0178;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.29673");
	}
	cell_fall(scalar) {
          values("0.30362");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.29673");
	}
	cell_fall(scalar) {
          values("0.30362");
	}
      }
    }
    pin("led") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.93958,1.94346,1.95317,1.97860,2.05221,2.27336,2.93326");
	}
	rise_transition(template_1) {
          values("0.01236,0.01617,0.02753,0.06308,0.17340,0.50502,1.49905");
	}
	cell_fall(template_1) {
          values("1.95088,1.95452,1.96305,1.98273,2.03370,2.18309,2.63243");
	}
	fall_transition(template_1) {
          values("0.01139,0.01411,0.02141,0.04196,0.10601,0.30354,0.90514");
	}
      }
    }
    pin("missed_dose_flag") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.51886,1.52326,1.53354,1.55918,1.63297,1.85582,2.51244");
	}
	rise_transition(template_1) {
          values("0.01554,0.01900,0.02948,0.06392,0.17314,0.50602,1.50196");
	}
	cell_fall(template_1) {
          values("1.38116,1.38477,1.39331,1.41303,1.46405,1.61381,2.06244");
	}
	fall_transition(template_1) {
          values("0.01145,0.01427,0.02136,0.04205,0.10623,0.30542,0.90273");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0032;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.17668");
	}
	fall_constraint(scalar) {
          values("-0.13021");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.64200");
	}
	fall_constraint(scalar) {
          values("0.77863");
	}
      }
    }
    pin("tick_1min") {
      direction : input;
      capacitance : 0.0029;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.09616");
	}
	fall_constraint(scalar) {
          values("-0.10524");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.65868");
	}
	fall_constraint(scalar) {
          values("0.81519");
	}
      }
    }
    bus("interval_sel") {
      bus_type : interval_sel;
      direction : input;
      capacitance : 0.0000;
    pin("interval_sel[1]") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.16008");
	}
	fall_constraint(scalar) {
          values("-0.11931");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.37394");
	}
	fall_constraint(scalar) {
          values("0.38939");
	}
      }
    }
    pin("interval_sel[0]") {
      direction : input;
      capacitance : 0.0035;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.18267");
	}
	fall_constraint(scalar) {
          values("-0.10830");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.35956");
	}
	fall_constraint(scalar) {
          values("0.39595");
	}
      }
    }
    }
  }

}
