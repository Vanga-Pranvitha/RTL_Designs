library (pill_reminder) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00150,  0.00450,  0.01348,  0.04042,  0.12121,  0.36347");
  }
  type ("interval_sel") {
    base_type : array;
    data_type : bit;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0;
  }

  cell ("pill_reminder") {
    interface_timing : true;
    pin("ack_btn") {
      direction : input;
      capacitance : 0.0028;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.01394");
	}
	fall_constraint(scalar) {
          values("-0.01853");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.00196");
	}
	fall_constraint(scalar) {
          values("0.04904");
	}
      }
    }
    pin("buzzer") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.12718,2.13106,2.14078,2.16622,2.23982,2.46074,3.12131");
	}
	rise_transition(template_1) {
          values("0.01233,0.01614,0.02751,0.06308,0.17346,0.50487,1.49828");
	}
	cell_fall(template_1) {
          values("2.06541,2.06905,2.07760,2.09726,2.14820,2.29753,2.74696");
	}
	fall_transition(template_1) {
          values("0.01139,0.01410,0.02138,0.04197,0.10589,0.30358,0.90507");
	}
      }
    }
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0172;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.29138");
	}
	cell_fall(scalar) {
          values("0.29941");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.29138");
	}
	cell_fall(scalar) {
          values("0.29941");
	}
      }
    }
    pin("led") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.91672,1.92060,1.93031,1.95574,2.02935,2.25043,2.91052");
	}
	rise_transition(template_1) {
          values("0.01235,0.01616,0.02752,0.06308,0.17342,0.50498,1.49883");
	}
	cell_fall(template_1) {
          values("1.93209,1.93573,1.94426,1.96394,2.01491,2.16429,2.61364");
	}
	fall_transition(template_1) {
          values("0.01139,0.01411,0.02141,0.04195,0.10601,0.30349,0.90520");
	}
      }
    }
    pin("missed_dose_flag") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.50365,1.50802,1.51828,1.54391,1.61768,1.84049,2.49717");
	}
	rise_transition(template_1) {
          values("0.01539,0.01887,0.02939,0.06388,0.17314,0.50600,1.50193");
	}
	cell_fall(template_1) {
          values("1.36824,1.37184,1.38037,1.40008,1.45110,1.60087,2.04952");
	}
	fall_transition(template_1) {
          values("0.01140,0.01422,0.02132,0.04203,0.10623,0.30541,0.90266");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0032;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.17343");
	}
	fall_constraint(scalar) {
          values("-0.12664");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.63088");
	}
	fall_constraint(scalar) {
          values("0.77195");
	}
      }
    }
    pin("tick_1min") {
      direction : input;
      capacitance : 0.0029;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.09628");
	}
	fall_constraint(scalar) {
          values("-0.10438");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.65439");
	}
	fall_constraint(scalar) {
          values("0.80945");
	}
      }
    }
    bus("interval_sel") {
      bus_type : interval_sel;
      direction : input;
      capacitance : 0.0000;
    pin("interval_sel[1]") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.15465");
	}
	fall_constraint(scalar) {
          values("-0.11619");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.36483");
	}
	fall_constraint(scalar) {
          values("0.38424");
	}
      }
    }
    pin("interval_sel[0]") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.17836");
	}
	fall_constraint(scalar) {
          values("-0.10577");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.35130");
	}
	fall_constraint(scalar) {
          values("0.39132");
	}
      }
    }
    }
  }

}
